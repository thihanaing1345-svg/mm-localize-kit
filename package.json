{
  "name": "mm-localize-kit",
  "version": "0.1.0",
  "description": "TypeScript-first utilities for Myanmar-language localization, validation, formatting, search normalization, and dataset cleanup.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/thihanaing1345-svg/mm-localize-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thihanaing1345-svg/mm-localize-kit.git"
  },
  "bugs": {
    "url": "https://github.com/thihanaing1345-svg/mm-localize-kit/issues"
  },
  "keywords": [
    "myanmar",
    "burmese",
    "localization",
    "i18n",
    "zawgyi",
    "unicode",
    "mmk",
    "typescript",
    "react",
    "nextjs"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data/townships": {
      "types": "./dist/geo/townships.d.ts",
      "import": "./dist/geo/townships.js"
    }
  },
  "bin": {
    "mm-localize": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
